# ============================================================
# TUAHORAV2 — variables de entorno (copiar a .env y completar)
# ============================================================

# ---------- Scheduler (scheduler/.env) ----------
PORT=3000
API_KEY=cambiar-esta-key
# CORS allowlist para la SPA en otra origen (GitHub Pages → API en Railway).
# Lista separada por comas de orígenes exactos. Vacía = allow all (dev local).
# NO usar RAILWAY_PRIVATE_DOMAIN (.railway.internal): los navegadores no lo resuelven.
# Producción (ejemplo):
# CORS_ALLOWED_ORIGINS=https://kamiikasee05.github.io
CORS_ALLOWED_ORIGINS=
NODE_ENV=development
LOG_LEVEL=debug

# Profesional activo (providerId del v1 = 5)
PROVIDER_ID=5

# Datos (SQLite + branding config.json)
DATA_DIR=./data

# OpenWA (WhatsApp)
OPENWA_BASE_URL=http://127.0.0.1:2785
# ... o por partes:
# OPENWA_HOST=127.0.0.1
# OPENWA_PORT=2785
OPENWA_API_KEY=cambiar
OPENWA_SESSION_ID=dev

# Opcionales (no usar en v2 — n8n eliminado)
# REDIS_URL=

# ---------- PHP (admin) — mismas keys que el Scheduler ----------
SCHEDULER_URL=http://127.0.0.1:3000/api/v1
SCHEDULER_API_KEY=cambiar-esta-key
# Hash bcrypt de la password del admin. Generar con:
#   php -r "echo password_hash('<password>', PASSWORD_BCRYPT);"
# Dev local (password: admin123):
#   $2y$12$YYegZ/VDEmhHX8XaYB50xeOVcE/moA53HGQCimxflfkKd1nut7Pki
ADMIN_PASSWORD_HASH=

# ---------- Dev local (Windows) — cómo levantar el stack ----------
# PHP 8.5.8 instalado por winget (no está en el PATH):
#   C:\Users\KAMIIKASEE\AppData\Local\Microsoft\WinGet\Packages\PHP.PHP.8.5_Microsoft.Winget.Source_8wekyb3d8bbwe\php.exe
#   (el php.ini activo se creó ahí a partir de php.ini-development; extensiones: curl, openssl,
#    pdo_sqlite, sqlite3, mbstring, fileinfo, gd)
# Arranque del stack completo (Scheduler :3000 + Admin PHP :8080):
#   & "E:\TUAHORAV2\scripts\dev-up.ps1"
#   Admin: http://127.0.0.1:8080/admin/  — Scheduler API: http://127.0.0.1:3000/api/v1

# ---------- OpenWA / otros (legacy EA, no usar) ----------
# EA_API_USER=
# EA_API_PASS=
# EA_ADMIN_PASSWORD=
# EA_BASE_URL=
